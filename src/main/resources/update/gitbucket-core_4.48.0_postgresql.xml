<?xml version="1.0" encoding="UTF-8"?>
<changeSet>
  <!--================================================================================================-->
  <!-- ACCOUNT - ADD ACCOUNT_ID COLUMN                                                                -->
  <!--================================================================================================-->

  <!-- Add ACCOUNT_ID as a unique numeric identifier for the GitHub compatibility api while
       retaining USER_NAME as the primary key. -->

  <sql>
    ALTER TABLE ACCOUNT
      ADD COLUMN ACCOUNT_ID BIGINT GENERATED BY DEFAULT AS IDENTITY,
      ADD CONSTRAINT IDX_ACCOUNT_ID UNIQUE (ACCOUNT_ID)
  </sql>
</changeSet>
