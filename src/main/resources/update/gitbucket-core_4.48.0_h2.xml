<changeSet>
  <!--================================================================================================-->
  <!-- ACCOUNT - ADD ACCOUNT_ID COLUMN                                                                -->
  <!--================================================================================================-->

  <!-- Add ACCOUNT_ID as a unique numeric identifier for the GitHub compatibility api while
       retaining USER_NAME as the primary key. -->

  <sql>ALTER TABLE ACCOUNT ADD COLUMN ACCOUNT_ID BIGINT AUTO_INCREMENT NOT NULL</sql>
  <sql>ALTER TABLE ACCOUNT ADD CONSTRAINT IDX_ACCOUNT_ID UNIQUE (ACCOUNT_ID)</sql>
</changeSet>
